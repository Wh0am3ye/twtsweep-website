diff --git a/combined-styles.css b/combined-styles.css
index 238e941..e3e2d3a 100644
--- a/combined-styles.css
+++ b/combined-styles.css
@@ -210,6 +210,18 @@ a {
   padding: 0.5rem 1rem;
 }
 
+.visually-hidden {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  margin: -1px;
+  overflow: hidden;
+  clip: rect(0, 0, 0, 0);
+  white-space: nowrap;
+  border: 0;
+}
+
 .text-link {
   text-decoration: underline;
 }
@@ -1009,3 +1021,17 @@ footer {
   left: 0;
   pointer-events: none;
 }
+
+/* =========================
+16. REDUCED MOTION
+========================= */
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.01ms !important;
+    scroll-behavior: auto !important;
+  }
+}
